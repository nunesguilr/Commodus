# Byte-code files (Python cache)
*.pyc
__pycache__/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.flaskenv

# IDE-specific settings
.idea/                  # PyCharm / IntelliJ IDEA
.vscode/                # VS Code
*.sublime-*             # Sublime Text
*.komodoproject         # Komodo IDE
*.kpf                   # Komodo IDE

# OS-specific files
.DS_Store               # macOS
Thumbs.db               # Windows
ehthumbs.db             # Windows
Desktop.ini             # Windows

# Logs and databases
*.log
*.sqlite3
*.db

# Data files (generated or downloaded)
data_cache/             # Diretório de cache de dados
commodities.csv         # Se este arquivo CSV for gerado ou baixado
*.json                  # Outros arquivos JSON gerados

# Python build artifacts
dist/
build/
*.egg-info/
.tox/

# Test and coverage reports
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Temporary files
*.bak
*.swp
*.tmp
*.cache